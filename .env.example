APP_NAME=Fırsat Avcısı + Meclis Takip
APP_VERSION=0.8.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# Production'da kendi domainlerini yaz:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Database
# Şu an aktif ve güvenli varsayılan: sqlite
# PostgreSQL için henüz repository adapter portu tamamlanmadan production'a alınmaz.
DATABASE_ENGINE=sqlite
DATABASE_PATH=data/app.db
# PostgreSQL hedef formatı:
# DATABASE_ENGINE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=

# Scheduler
ENABLE_SCHEDULER=true
SOURCE_SYNC_INTERVAL_MINUTES=60

# Feed ayarları
MAX_FEED_ITEMS_PER_SYNC=500
HTTP_TIMEOUT_SECONDS=45

# Veri klasörü
DATA_DIR=data
